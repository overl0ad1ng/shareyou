{
  "name": "@shareyou/core",
  "version": "0.1.0",
  "description": "A unified entry point for Shareyou utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "test": "pnpm run build && node --test",
    "typecheck": "pnpm run build && tsc -p tsconfig.typecheck.json",
    "demo": "pnpm run build && node examples/node.mjs",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "shareyou",
    "utilities",
    "typescript"
  ],
  "author": {
    "name": "IzayoiKyomu",
    "email": "kyomu@overl0ad1ng.com"
  },
  "license": "MIT",
  "homepage": "https://shareyou.overl0ad1ng.com/docs",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@shareyou/i18n": "workspace:^",
    "@shareyou/templater": "workspace:^"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
